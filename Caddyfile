# ══════════════════════════════════════════════════════════════════════
#  BEARTIFY — Caddyfile v3 (avec Secure Stream Server)
#  TLS automatique Let's Encrypt.
#  Nouveauté : /api/stream-token/* et /api/secure-stream/*
#  sont routés vers le serveur Node (127.0.0.1:3001) dans tous
#  les blocs Beartify (prod + LAN).
# ══════════════════════════════════════════════════════════════════════

{
    email admin@grizzlyrics.duckdns.org
    log {
        output file /var/log/caddy/caddy.log
        format json
        level  INFO
    }
}

# ══════════════════════════════════════════════════════════════════════
#  SNIPPET — CORS pour Tauri V2
# ══════════════════════════════════════════════════════════════════════
(cors_tauri) {
    @cors_preflight {
        method OPTIONS
        header Origin *
    }
    handle @cors_preflight {
        header Access-Control-Allow-Origin  "{http.request.header.Origin}"
        header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, HEAD, PATCH"
        header Access-Control-Allow-Headers "Content-Type, Authorization, Range, X-Requested-With, Accept, Origin"
        header Access-Control-Max-Age       "86400"
        header Vary "Origin"
        respond "" 204
    }
    @has_origin header Origin *
    header @has_origin Access-Control-Allow-Origin  "{http.request.header.Origin}"
    header @has_origin Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, HEAD, PATCH"
    header @has_origin Access-Control-Allow-Headers "Content-Type, Authorization, Range, X-Requested-With, Accept, Origin"
    header @has_origin Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges"
    header @has_origin Vary "Origin"
}

# ══════════════════════════════════════════════════════════════════════
#  SNIPPET — Routes vers le Secure Stream Server (Node :3001)
#
#  Doit être importé AVANT le bloc /api/jellyfin/* général.
#  Caddy évalue les handle dans l'ordre → ce bloc est prioritaire.
#
#  /api/stream-token/:id  → Node génère un JWT 60s lié à l'IP
#  /api/secure-stream/:id → Node valide le JWT puis pipe Jellyfin
#
#  flush_interval -1 : transmission chunk-by-chunk sans tampon Caddy
#  (indispensable pour que l'audio commence instantanément).
# ══════════════════════════════════════════════════════════════════════
(secure_stream_routes) {
    # ── Émission de token ────────────────────────────────────────────
    handle /api/stream-token/* {
        reverse_proxy 127.0.0.1:3001 {
            header_up  X-Real-IP       {remote_host}
            header_up  X-Forwarded-For {remote_host}
            header_down Cache-Control  "no-store"
        }
    }

    # ── Stream sécurisé ──────────────────────────────────────────────
    handle /api/secure-stream/* {
        reverse_proxy 127.0.0.1:3001 {
            flush_interval -1
            header_up  X-Real-IP       {remote_host}
            header_up  X-Forwarded-For {remote_host}
        }
    }
}

# ──────────────────────────────────────────────────────────────────────
#  1. NEXTCLOUD — grizzlyrics.duckdns.org
# ──────────────────────────────────────────────────────────────────────
grizzlyrics.duckdns.org {
    root * /var/www/nextcloud
    php_fastcgi unix//run/php/php8.4-fpm.sock
    file_server
    encode zstd gzip
    request_body { max_size 10GB }
    header {
        Strict-Transport-Security "max-age=15768000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), microphone=(), camera=()"
        -Server
    }
    log { output file /var/log/caddy/nextcloud-access.log; format json }
}

# ──────────────────────────────────────────────────────────────────────
#  2. JELLYFIN — grizzly-stream.duckdns.org
# ──────────────────────────────────────────────────────────────────────
grizzly-stream.duckdns.org {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=15768000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }
    handle_path /wol* { reverse_proxy 127.0.0.1:8080 }
    handle {
        reverse_proxy 127.0.0.1:8096 {
            header_up Host              {host}
            header_up X-Real-IP         {remote_host}
            header_up X-Forwarded-For   {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up Connection        {http.request.header.Connection}
            header_up Upgrade           {http.request.header.Upgrade}
        }
    }
    log { output file /var/log/caddy/jellyfin-access.log; format json }
}

# ──────────────────────────────────────────────────────────────────────
#  3. BEARTIFY — beartify.duckdns.org
# ──────────────────────────────────────────────────────────────────────
beartify.duckdns.org {
    import cors_tauri

    root * /var/www/html/player
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=15768000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), microphone=(), camera=(), payment=()"
        Content-Security-Policy   "default-src 'self' https://beartify-firebase.firebaseapp.com; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://discord.com https://lrclib.net https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://apis.google.com https://accounts.google.com https://www.gstatic.com wss://grizzly-stream.duckdns.org https://grizzly-stream.duckdns.org; frame-src 'self' https://beartify-firebase.firebaseapp.com https://accounts.google.com; frame-ancestors 'none';"
        -Server
    }

    @static { path *.js *.css *.woff2 *.woff *.ttf *.png *.jpg *.svg *.ico *.webp *.gif }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # ── 🔐 TOKEN + STREAM SÉCURISÉ (prioritaire sur /api/jellyfin/*) ──
    import secure_stream_routes

    # ── PROXY JELLYFIN ────────────────────────────────────────────────
    handle /api/jellyfin/* {
        uri strip_prefix /api/jellyfin
        reverse_proxy 127.0.0.1:8096 {
            flush_interval -1
            header_up  X-Emby-Token      "aaa8a7df4b364cf7bcc76f351d768798"
            header_up  Host              grizzly-stream.duckdns.org
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_up  X-Forwarded-Proto {scheme}
            header_up  Connection        {http.request.header.Connection}
            header_up  Upgrade           {http.request.header.Upgrade}
            header_down -X-Emby-Token
            header_down -Access-Control-Allow-Origin
            header_down Location "https://grizzly-stream.duckdns.org" "/api/jellyfin"
            header_down Location "http://grizzly-stream.duckdns.org"  "/api/jellyfin"
            header_down Location "http://127.0.0.1:8096"              "/api/jellyfin"
            header_down Location `\?api_key=[^&]*&` `?`
            header_down Location `\?api_key=[^&]*$` ``
            header_down Location `&api_key=[^&]*`   ``
        }
    }

    # ── PROXY LAST.FM ─────────────────────────────────────────────────
    handle /api/lastfm/* {
        uri strip_prefix /api/lastfm
        rewrite * {path}?{query}&api_key=b25b959554ed76058ac220b7b2e0a026&format=json
        reverse_proxy https://ws.audioscrobbler.com {
            header_up  Host              ws.audioscrobbler.com
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_down -X-Api-Key
            header_down -Access-Control-Allow-Origin
        }
    }

    # ── PROXY GRIZZLYRICS ─────────────────────────────────────────────
    handle /api/lyrics/* {
        uri strip_prefix /api/lyrics
        reverse_proxy 127.0.0.1:443 {
            header_up  Host              grizzlyrics.duckdns.org
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_up  X-Forwarded-Proto https
            header_down Location "https://grizzlyrics.duckdns.org:443" "/api/lyrics"
            header_down Location "https://grizzlyrics.duckdns.org"     "/api/lyrics"
            header_down Location "http://grizzlyrics.duckdns.org:443"  "/api/lyrics"
            header_down Location "http://grizzlyrics.duckdns.org"      "/api/lyrics"
            header_down -Access-Control-Allow-Origin
            transport http { tls; tls_server_name grizzlyrics.duckdns.org }
        }
    }

    @notFile {
        not path *.js *.css *.png *.jpg *.svg *.ico *.woff* *.ttf *.webp *.json *.html *.gif
        not path /api/*
    }
    rewrite @notFile /index.html
    file_server
    log { output file /var/log/caddy/beartify-access.log; format json }
}

# ──────────────────────────────────────────────────────────────────────
#  4. GRIZZLYFIN — grizzlyfin.duckdns.org
# ──────────────────────────────────────────────────────────────────────
grizzlyfin.duckdns.org {
    root * /var/www/bearflix/
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=15768000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), microphone=(), camera=()"
        -Server
    }
    @static { path *.js *.css *.woff2 *.woff *.ttf *.png *.jpg *.jpeg *.gif *.svg *.ico *.webp *.mp4 *.webm }
    header @static Cache-Control "public, max-age=31536000, immutable"
    file_server
    log { output file /var/log/caddy/grizzlyfin-access.log; format json }
}

