# ══════════════════════════════════════════════════════════════════════
#  BEARTIFY — Caddyfile
#  TLS automatique Let's Encrypt, clés API jamais exposées au client,
#  headers de sécurité stricts sur les trois domaines.
#  Bloc :8888 pour le dev local (LAN uniquement, sans TLS).
# ══════════════════════════════════════════════════════════════════════

# ── Options globales ───────────────────────────────────────────────────
{
    email admin@grizzlyrics.duckdns.org

    log {
        output file /var/log/caddy/caddy.log
        format json
        level  INFO
    }
}

# ──────────────────────────────────────────────────────────────────────
#  1. NEXTCLOUD — grizzlyrics.duckdns.org
# ──────────────────────────────────────────────────────────────────────
grizzlyrics.duckdns.org {

    root * /var/www/nextcloud
    php_fastcgi unix//run/php/php8.4-fpm.sock
    file_server

    encode zstd gzip

    request_body {
        max_size 10GB
    }

    header {
        Strict-Transport-Security "max-age=15768000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), microphone=(), camera=()"
        -Server
    }

    log {
        output file /var/log/caddy/nextcloud-access.log
        format json
    }
}

# ──────────────────────────────────────────────────────────────────────
#  2. JELLYFIN — grizzly-stream.duckdns.org
# ──────────────────────────────────────────────────────────────────────
grizzly-stream.duckdns.org {

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=15768000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }

    handle_path /wol* {
        reverse_proxy 127.0.0.1:8080
    }

    handle {
        reverse_proxy 127.0.0.1:8096 {
            header_up  Host              {host}
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_up  X-Forwarded-Proto {scheme}
            header_up  Connection        {http.request.header.Connection}
            header_up  Upgrade           {http.request.header.Upgrade}
        }
    }

    log {
        output file /var/log/caddy/jellyfin-access.log
        format json
    }
}

# ──────────────────────────────────────────────────────────────────────
#  3. BEARTIFY — beartify.duckdns.org
# ──────────────────────────────────────────────────────────────────────
beartify.duckdns.org {

    root * /var/www/html/player
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=15768000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), microphone=(), camera=(), payment=()"
        Content-Security-Policy   "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: /api/jellyfin; media-src 'self' /api/jellyfin; connect-src 'self' wss://grizzly-stream.duckdns.org /api/; frame-ancestors 'none'"
        -Server
    }

    @static {
        path *.js *.css *.woff2 *.woff *.ttf *.png *.jpg *.svg *.ico *.webp
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    handle /api/jellyfin/* {
        uri strip_prefix /api/jellyfin
        reverse_proxy 127.0.0.1:8096 {
            header_up  X-Emby-Token      "aaa8a7df4b364cf7bcc76f351d768798"
            header_up  Host              grizzly-stream.duckdns.org
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_up  X-Forwarded-Proto {scheme}
            header_up  Connection        {http.request.header.Connection}
            header_up  Upgrade           {http.request.header.Upgrade}
            header_down -X-Emby-Token
        }
    }

    handle /api/lastfm/* {
        uri strip_prefix /api/lastfm
        rewrite * {path}?{query}&api_key=b25b959554ed76058ac220b7b2e0a026&format=json
        reverse_proxy https://ws.audioscrobbler.com {
            header_up  Host              ws.audioscrobbler.com
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_down -X-Api-Key
        }
    }

    handle /api/lyrics/* {
        uri strip_prefix /api/lyrics
        reverse_proxy 127.0.0.1:80 {
            header_up  Host              grizzlyrics.duckdns.org
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
        }
    }

    @notFile {
        not path *.js *.css *.png *.jpg *.svg *.ico *.woff* *.ttf *.webp *.json
        not path /api/*
    }
    rewrite @notFile /index.html

    file_server

    log {
        output file /var/log/caddy/beartify-access.log
        format json
    }
}

# ──────────────────────────────────────────────────────────────────────
#  4. DEV LOCAL — :8888 (LAN uniquement, pas de TLS)
# ──────────────────────────────────────────────────────────────────────
:8888 {

    # Bloquer tout ce qui ne vient pas du LAN
    @blocked not remote_ip 192.168.0.0/24
    abort @blocked

    encode zstd gzip

    # CORS — Caddy pose le header une seule fois.
    # Chaque reverse_proxy supprime le header upstream pour éviter la duplication.
    header Access-Control-Allow-Origin  "*"
    header Access-Control-Allow-Methods "GET, POST, OPTIONS"
    header Access-Control-Allow-Headers "Content-Type, Authorization"

    @options method OPTIONS
    respond @options 204

    handle /api/jellyfin/* {
        uri strip_prefix /api/jellyfin
        reverse_proxy 127.0.0.1:8096 {
            header_up   X-Emby-Token      "aaa8a7df4b364cf7bcc76f351d768798"
            header_up   Host              grizzly-stream.duckdns.org
            header_up   X-Real-IP         {remote_host}
            header_up   X-Forwarded-For   {remote_host}
            header_up   X-Forwarded-Proto {scheme}
            header_up   Connection        {http.request.header.Connection}
            header_up   Upgrade           {http.request.header.Upgrade}
            header_down -X-Emby-Token
            header_down -Access-Control-Allow-Origin
        }
    }

    handle /api/lastfm/* {
        uri strip_prefix /api/lastfm
        rewrite * {path}?{query}&api_key=b25b959554ed76058ac220b7b2e0a026&format=json
        reverse_proxy https://ws.audioscrobbler.com {
            header_up   Host              ws.audioscrobbler.com
            header_up   X-Real-IP         {remote_host}
            header_down -X-Api-Key
            header_down -Access-Control-Allow-Origin
        }
    }

    handle /api/lyrics/* {
        uri strip_prefix /api/lyrics
        reverse_proxy https://grizzlyrics.duckdns.org {
            header_up   Host              grizzlyrics.duckdns.org
            header_up   X-Real-IP         {remote_host}
            header_up   X-Forwarded-For   {remote_host}
            header_down -Access-Control-Allow-Origin
        }
    }

    root * /var/www/html/player

    @notFile {
        not path *.js *.css *.png *.jpg *.svg *.ico *.woff* *.ttf *.webp *.json
        not path /api/*
    }
    rewrite @notFile /index.html

    file_server

    log {
        output stderr
        format console
    }
}
