# ══════════════════════════════════════════════════════════════════════
#  BEARTIFY — Caddyfile durci v2.2 (Correction définitive CORS & Regexp)
# ══════════════════════════════════════════════════════════════════════

# ── Options globales ───────────────────────────────────────────────────
{
    # Email utilisé pour les certificats Let's Encrypt
    email admin@grizzlyrics.duckdns.org

    # Logs structurés centralisés
    log {
        output file /var/log/caddy/caddy.log
        format json
        level  INFO
    }
}


# ══════════════════════════════════════════════════════════════════════
#  SNIPPET — CORS pour Tauri V2 (Corrigé)
# ══════════════════════════════════════════════════════════════════════
(cors_tauri) {
    # CORS dédié à Tauri/local et au domaine de prod
    @origin_ok header_regexp Origin ^((https?://(?:beartify\.duckdns\.org|tauri\.localhost(?::\d+)?|192\.168\.0\.(?:2|18)(?::\d+)?))|tauri://localhost)$

    @cors_preflight {
        method OPTIONS
        header Origin *
    }

    handle @cors_preflight {
        @preflight_ok header_regexp Origin ^((https?://(?:beartify\.duckdns\.org|tauri\.localhost(?::\d+)?|192\.168\.0\.(?:2|18)(?::\d+)?))|tauri://localhost)$

        header @preflight_ok Access-Control-Allow-Origin  "{http.request.header.Origin}"
        header @preflight_ok Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, HEAD, PATCH"
        header @preflight_ok Access-Control-Allow-Headers "Content-Type, Authorization, Range, X-Requested-With, Accept, Origin"
        header @preflight_ok Access-Control-Allow-Credentials "true"
        header @preflight_ok Access-Control-Max-Age       "86400"
        header @preflight_ok Vary "Origin"
        respond "" 204
    }

    header @origin_ok Access-Control-Allow-Origin  "{http.request.header.Origin}"
    header @origin_ok Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, HEAD, PATCH"
    header @origin_ok Access-Control-Allow-Headers "Content-Type, Authorization, Range, X-Requested-With, Accept, Origin"
    header @origin_ok Access-Control-Allow-Credentials "true"
    header @origin_ok Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges"
    header @origin_ok Vary "Origin"
}

# ══════════════════════════════════════════════════════════════════════
#  SNIPPET — Routes HLS/DRM + Marketplace → drm.js (:3001)
# ══════════════════════════════════════════════════════════════════════
(drm_routes) {
    handle /api/hls/* {
        reverse_proxy 127.0.0.1:3001 {
            flush_interval -1
            header_up  X-Real-IP       {remote_host}
            header_up  X-Forwarded-For {remote_host}
        }
    }

    handle /api/extensions* {
        reverse_proxy 127.0.0.1:3001 {
            header_up  X-Real-IP       {remote_host}
            header_up  X-Forwarded-For {remote_host}
        }
    }

    # Liste blanche des ids "certifiés" pour le Marketplace communautaire.
    # Fichier statique plutôt que route applicative : la certifier un id
    # se résume à éditer ce fichier JSON, sans toucher au backend Node ni
    # redéployer quoi que ce soit.
    # "index index.json" est indispensable : le client appelle /api/certified
    # sans nom de fichier, et file_server ne sert index.json par défaut que
    # si on le lui indique explicitement (sinon il cherche index.html).
    handle_path /api/certified* {
        root * /var/www/beartify-certified
        header Cache-Control "no-store"
        file_server {
            index index.json
        }
    }

    # Statistiques du catalogue (stats-cron.js, voir OUTPUT_DIR dans
    # .env.stats) — servi directement en fichier statique plutôt que
    # via un lien de partage Nextcloud, plus simple à exposer et plus
    # stable d'une version de Nextcloud à l'autre (même logique que
    # /api/certified* ci-dessus). Résultat : onboarding.js peut lire
    # /api/stats/stats.json en same-origin, sans CORS ni token à gérer.
    # ⚠️ Le dossier local doit être lisible par l'utilisateur système de
    # Caddy : chmod -R a+rX /opt/beartify/stats-output
    handle_path /api/stats* {
        root * /opt/beartify/stats-output
        header Cache-Control "no-store"
        file_server {
            index stats.json
        }
    }

    # Recherche GitHub par topic (découverte communautaire du Marketplace),
    # relayée directement par Caddy avec un token attaché côté serveur —
    # évite que le client appelle api.github.com sans authentification
    # (limite 10 req/min, vite épuisée et partagée entre tous les
    # utilisateurs derrière la même IP). {$GITHUB_TOKEN} est résolu depuis
    # une variable d'environnement au démarrage de Caddy (jamais exposée
    # au client). GitHub exige aussi un User-Agent sur toute requête API.
    handle_path /api/github/search* {
        rewrite * /search/repositories?q=topic:{http.request.uri.query.topic}&per_page=50
        reverse_proxy https://api.github.com {
            header_up Host api.github.com
            header_up Authorization "token {$GITHUB_TOKEN}"
            header_up Accept "application/vnd.github+json"
            header_up User-Agent "Beartify-Marketplace"

            # GitHub renvoie déjà son propre Access-Control-Allow-Origin: *.
            # Sans le retirer ici, cors_tauri (importé plus bas dans le site
            # block) en ajoute un second par-dessus, et le navigateur reçoit
            # deux valeurs pour le même header → bloqué par CORS (déjà vu
            # exactement ce bug avec le proxy PocketBase).
            header_down -Access-Control-Allow-Origin
        }
    }
}


# ══════════════════════════════════════════════════════════════════════
#  SNIPPET — LibreTranslate auto-hébergé (:3005)
# ══════════════════════════════════════════════════════════════════════
(libretranslate_proxy) {
    handle /api/translate/* {
        uri strip_prefix /api/translate

        reverse_proxy 127.0.0.1:3005 {
            header_up  Host             127.0.0.1:3005
            header_up  X-Real-IP        {remote_host}
            header_up  X-Forwarded-For  {remote_host}
            header_down -Access-Control-Allow-Origin

            transport http {
                # Inférence neuronale locale : plus lent que le scraping
                # Lingva, d'où des délais augmentés.
                response_header_timeout 25s
                dial_timeout            5s
            }
        }
    }
}


# ══════════════════════════════════════════════════════════════════════
#  SNIPPET — Import de playlists Spotify/Deezer (playlist-import-service.js, :4501)
# ══════════════════════════════════════════════════════════════════════
# Service Node autonome (pas server.js) — voir playlist-import-service.js.
# Même schéma que les autres proxies /api/* : strip du préfixe, relais
# vers le port local du service. Le service gère lui-même son propre
# CORS (ALLOWED_ORIGIN) ; -Access-Control-Allow-Origin retire l'entête
# que Caddy pourrait dupliquer via cors_tauri plus haut dans le bloc de
# site, pour éviter le même bug à deux valeurs déjà rencontré avec
# PocketBase et GitHub.
(playlist_import_proxy) {
    handle /api/playlist/* {
        uri strip_prefix /api/playlist
        reverse_proxy 127.0.0.1:4501 {
            header_up  X-Real-IP       {remote_host}
            header_up  X-Forwarded-For {remote_host}
            header_down -Access-Control-Allow-Origin
        }
    }
}


# ══════════════════════════════════════════════════════════════════════
#  SNIPPET — Téléchargement VIP MP3
# ══════════════════════════════════════════════════════════════════════
(download_vip_headers) {
    @mp3_download {
        path /api/jellyfin/Audio/*/stream
        query Container=mp3
    }
    header @mp3_download Content-Disposition "attachment"
    header @mp3_download Cache-Control       "no-store, no-cache"
}


# ──────────────────────────────────────────────────────────────────────
#  1. NEXTCLOUD — grizzlyrics.duckdns.org
# ──────────────────────────────────────────────────────────────────────
grizzlyrics.duckdns.org {

    root * /var/www/nextcloud
    php_fastcgi unix//run/php/php8.4-fpm.sock
    file_server

    encode zstd gzip

    request_body {
        max_size 10GB
    }

    header {
        Strict-Transport-Security "max-age=15768000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), microphone=(), camera=()"
        -Server
    }

    log {
        output file /var/log/caddy/nextcloud-access.log
        format json
    }
}


# ──────────────────────────────────────────────────────────────────────
#  2. JELLYFIN — grizzly-stream.duckdns.org
# ──────────────────────────────────────────────────────────────────────
grizzly-stream.duckdns.org {

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=15768000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }

    handle_path /wol* {
        reverse_proxy 127.0.0.1:8080
    }

    handle {
        reverse_proxy 127.0.0.1:8096 {
            header_up  Host              {host}
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_up  X-Forwarded-Proto {scheme}
            header_up  Connection        {http.request.header.Connection}
            header_up  Upgrade           {http.request.header.Upgrade}
        }
    }

    log {
        output file /var/log/caddy/jellyfin-access.log
        format json
    }
}


# ──────────────────────────────────────────────────────────────────────
#  3. BEARTIFY — beartify.duckdns.org
# ──────────────────────────────────────────────────────────────────────
beartify.duckdns.org {

    # Forcer le nettoyage des doubles slashes en amont
    import cors_tauri
    route {
        uri replace // /
    }

    root * /var/www/beartify
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=15768000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), microphone=(), camera=(), payment=()"

        Content-Security-Policy "default-src 'self' https://beartify-firebase.firebaseapp.com; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://discord.com https://lrclib.net https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://apis.google.com https://accounts.google.com https://www.gstatic.com wss://grizzly-stream.duckdns.org https://grizzly-stream.duckdns.org; frame-src 'self' https://beartify-firebase.firebaseapp.com https://accounts.google.com; frame-ancestors 'none';"

        -Server
    }

    @static {
        path *.js *.css *.woff2 *.woff *.ttf *.png *.jpg *.svg *.ico *.webp *.gif
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # sw.js ne doit JAMAIS être mis en cache longue durée par le navigateur :
    # c'est ce fichier qui déclenche la détection de mise à jour du Service
    # Worker (P2-3) — @static ci-dessus le catégorise à tort comme un *.js
    # normal et le rendrait immutable pendant un an, bloquant toute mise à
    # jour du SW. manifest.json est moins critique mais reçoit un cache
    # court plutôt que le "immutable" 1 an de @static, au cas où icônes ou
    # nom changeraient.
    @sw_file {
        path /sw.js
    }
    header @sw_file Cache-Control "no-cache, no-store, must-revalidate"
    header @sw_file Service-Worker-Allowed "/"

    @manifest_file {
        path /manifest.json
    }
    header @manifest_file Cache-Control "public, max-age=86400"

    # Covers Jellyfin proxifiées : le chemin ne se termine jamais par une
    # extension de fichier (ex: /api/jellyfin/Items/{id}/Images/Primary),
    # donc le matcher @static ci-dessus ne les attrape jamais malgré son nom
    # trompeur — elles repartaient donc sans cache long, re-téléchargées à
    # chaque session. Le tag d'image dans l'URL (?tag=...) les rend uniques
    # par version, donc un cache "immutable" est sans danger ici aussi.
    @jellyfin_images {
        path /api/jellyfin/Items/*/Images/*
    }
    header @jellyfin_images Cache-Control "no-cache"

    # 🔐 HLS DRM
    import drm_routes

    # LibreTranslate
    import libretranslate_proxy
    import playlist_import_proxy

    # Headers téléchargement VIP MP3
    import download_vip_headers

    # PROXY POCKETBASE (Beartify — playlists / présence / social / stats)
    handle /api/pb/* {
        uri strip_prefix /api/pb
        reverse_proxy 127.0.0.1:8095 {
            header_up  X-Real-IP       {remote_host}
            header_up  X-Forwarded-For {remote_host}
            # flush_interval -1 : désactive la bufferisation de Caddy pour
            # cette route — indispensable pour le temps réel PocketBase
            # (Server-Sent Events), sinon les mises à jour de présence
            # peuvent être retardées de plusieurs secondes.
            flush_interval -1
        }
    }

    # PROXY JELLYFIN
    handle /api/jellyfin/* {
        uri strip_prefix /api/jellyfin

        reverse_proxy 127.0.0.1:8096 {
            flush_interval -1

            header_up  X-Emby-Token      "7510ccb4df644453aad890f454549d15"
            header_up  Host              grizzly-stream.duckdns.org
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_up  X-Forwarded-Proto {scheme}
            header_up  Connection        {http.request.header.Connection}
            header_up  Upgrade           {http.request.header.Upgrade}

            # ✅ FIX CORS v2 (bug covers arrière-plan immersif en Tauri) :
            # header_down est exécuté APRÈS le "header @origin_ok" posé par
            # cors_tauri en tête de site block, sur la même map de réponse.
            # Du coup l'ancien "header_down -Access-Control-Allow-Origin" ne
            # supprimait pas seulement l'en-tête renvoyé par Jellyfin : il
            # supprimait AUSSI celui déjà ajouté par cors_tauri, laissant la
            # réponse totalement sans Access-Control-Allow-Origin. Invisible
            # en usage web classique (requête same-origin, CORS non vérifié
            # par le navigateur) mais bloquant en Tauri (webview sur une
            # origine différente → requête cross-origin → CORS appliqué).
            # On supprime donc l'en-tête existant (celui de Jellyfin, ou le
            # nôtre déjà consommé) PUIS on le réinjecte nous-mêmes avec la
            # bonne valeur, dans ce même bloc, pour être sûrs qu'il survit
            # jusqu'à la réponse finale.
            header_down -X-Emby-Token
            header_down -Access-Control-Allow-Origin
            header_down Access-Control-Allow-Origin "{http.request.header.Origin}"
            header_down -Cache-Control
            header_down Location "https://grizzly-stream.duckdns.org" "/api/jellyfin"
            header_down Location "http://grizzly-stream.duckdns.org"  "/api/jellyfin"
            header_down Location "http://127.0.0.1:8096"              "/api/jellyfin"
            header_down Location `\?api_key=[^&]*&` `?`
            header_down Location `\?api_key=[^&]*$` ``
            header_down Location `&api_key=[^&]*`   ``
        }
    }

    # PROXY LAST.FM
    handle /api/lastfm/* {
        uri strip_prefix /api/lastfm
        rewrite * {path}?{query}&api_key=b25b959554ed76058ac220b7b2e0a026&format=json

        reverse_proxy https://ws.audioscrobbler.com {
            header_up  Host              ws.audioscrobbler.com
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_down -X-Api-Key
            header_down -Access-Control-Allow-Origin
        }
    }

    # PROXY GRIZZLYRICS
    handle /api/lyrics/* {
        uri strip_prefix /api/lyrics

        reverse_proxy 127.0.0.1:443 {
            header_up  Host              grizzlyrics.duckdns.org
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_up  X-Forwarded-Proto https

            header_down Location "https://grizzlyrics.duckdns.org:443" "/api/lyrics"
            header_down Location "https://grizzlyrics.duckdns.org"     "/api/lyrics"
            header_down Location "http://grizzlyrics.duckdns.org:443"  "/api/lyrics"
            header_down Location "http://grizzlyrics.duckdns.org"      "/api/lyrics"
            header_down -Access-Control-Allow-Origin

            transport http {
                tls
                tls_server_name grizzlyrics.duckdns.org
            }
        }
    }

    # PROXY NEXTCLOUD
    handle /api/nextcloud/* {
        uri strip_prefix /api/nextcloud

        reverse_proxy 127.0.0.1:443 {
            header_up  Host              grizzlyrics.duckdns.org
            header_up  Authorization     "Basic cGFwYW91cnM6MjkwODA5"
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_up  X-Forwarded-Proto https

            header_down -Authorization
            header_down -WWW-Authenticate
            header_down -Access-Control-Allow-Origin

            transport http {
                tls
                tls_server_name grizzlyrics.duckdns.org
            }
        }
    }

    @notFile {
        not path *.js *.css *.png *.jpg *.svg *.ico *.woff* *.ttf *.webp *.json *.html *.gif
        not path /api/*
    }
    rewrite @notFile /index.html
    file_server

    log {
        output file /var/log/caddy/beartify-access.log
        format json
    }
}


# ──────────────────────────────────────────────────────────────────────
#  4. GRIZZLYFIN — grizzlyfin.duckdns.org
# ──────────────────────────────────────────────────────────────────────
grizzlyfin.duckdns.org {

    root * /var/www/bearflix/
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=15768000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), microphone=(), camera=()"
        -Server
    }

    @static {
        path *.js *.css *.woff2 *.woff *.ttf *.png *.jpg *.jpeg *.gif *.svg *.ico *.webp *.mp4 *.webm
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    @jellyfin_images {
        path /api/jellyfin/Items/*/Images/*
    }
    header @jellyfin_images Cache-Control "no-cache"

    file_server

    log {
        output file /var/log/caddy/grizzlyfin-access.log
        format json
    }
}


# ──────────────────────────────────────────────────────────────────────
#  5. BEARTIFY LAN — http://192.168.0.18
# ──────────────────────────────────────────────────────────────────────
http://192.168.0.18 {

    import cors_tauri
    route {
        uri replace // /
    }

    root * /var/www/beartify
    encode zstd gzip

    header {
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }

    @static {
        path *.js *.css *.woff2 *.woff *.ttf *.png *.jpg *.svg *.ico *.webp
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # sw.js ne doit JAMAIS être mis en cache longue durée par le navigateur :
    # c'est ce fichier qui déclenche la détection de mise à jour du Service
    # Worker (P2-3) — @static ci-dessus le catégorise à tort comme un *.js
    # normal et le rendrait immutable pendant un an, bloquant toute mise à
    # jour du SW. manifest.json est moins critique mais reçoit un cache
    # court plutôt que le "immutable" 1 an de @static, au cas où icônes ou
    # nom changeraient.
    @sw_file {
        path /sw.js
    }
    header @sw_file Cache-Control "no-cache, no-store, must-revalidate"
    header @sw_file Service-Worker-Allowed "/"

    @manifest_file {
        path /manifest.json
    }
    header @manifest_file Cache-Control "public, max-age=86400"

    @jellyfin_images {
        path /api/jellyfin/Items/*/Images/*
    }
    header @jellyfin_images Cache-Control "no-cache"

    import drm_routes
    import libretranslate_proxy
    import playlist_import_proxy
    import download_vip_headers

    # PROXY POCKETBASE (Beartify — playlists / présence / social / stats)
    handle /api/pb/* {
        uri strip_prefix /api/pb
        reverse_proxy 127.0.0.1:8095 {
            header_up  X-Real-IP       {remote_host}
            header_up  X-Forwarded-For {remote_host}
            flush_interval -1
        }
    }

    handle /api/jellyfin/* {
        uri strip_prefix /api/jellyfin

        reverse_proxy 127.0.0.1:8096 {
            flush_interval -1

            header_up  X-Emby-Token      "7510ccb4df644453aad890f454549d15"
            header_up  Host              grizzly-stream.duckdns.org
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_up  X-Forwarded-Proto {scheme}
            header_up  Connection        {http.request.header.Connection}
            header_up  Upgrade           {http.request.header.Upgrade}

            # ✅ FIX CORS v2 (bug covers arrière-plan immersif en Tauri) :
            # header_down est exécuté APRÈS le "header @origin_ok" posé par
            # cors_tauri en tête de site block, sur la même map de réponse.
            # Du coup l'ancien "header_down -Access-Control-Allow-Origin" ne
            # supprimait pas seulement l'en-tête renvoyé par Jellyfin : il
            # supprimait AUSSI celui déjà ajouté par cors_tauri, laissant la
            # réponse totalement sans Access-Control-Allow-Origin. Invisible
            # en usage web classique (requête same-origin, CORS non vérifié
            # par le navigateur) mais bloquant en Tauri (webview sur une
            # origine différente → requête cross-origin → CORS appliqué).
            # On supprime donc l'en-tête existant (celui de Jellyfin, ou le
            # nôtre déjà consommé) PUIS on le réinjecte nous-mêmes avec la
            # bonne valeur, dans ce même bloc, pour être sûrs qu'il survit
            # jusqu'à la réponse finale.
            header_down -Access-Control-Allow-Origin
            header_down Access-Control-Allow-Origin "{http.request.header.Origin}"
            header_down -X-Emby-Token
            header_down -Cache-Control
            header_down Location "https://grizzly-stream.duckdns.org" "/api/jellyfin"
            header_down Location "http://grizzly-stream.duckdns.org"  "/api/jellyfin"
            header_down Location "http://127.0.0.1:8096"              "/api/jellyfin"
            header_down Location `\?api_key=[^&]*&` `?`
            header_down Location `\?api_key=[^&]*$` ``
            header_down Location `&api_key=[^&]*`   ``
        }
    }

    handle /api/lastfm/* {
        uri strip_prefix /api/lastfm
        rewrite * {path}?{query}&api_key=b25b959554ed76058ac220b7b2e0a026&format=json

        reverse_proxy https://ws.audioscrobbler.com {
            header_up  Host              ws.audioscrobbler.com
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_down -X-Api-Key
            header_down -Access-Control-Allow-Origin
        }
    }

    handle /api/lyrics/* {
        uri strip_prefix /api/lyrics

        reverse_proxy 127.0.0.1:443 {
            header_up  Host              grizzlyrics.duckdns.org
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_up  X-Forwarded-Proto https

            header_down Location "https://grizzlyrics.duckdns.org:443" "/api/lyrics"
            header_down Location "https://grizzlyrics.duckdns.org"     "/api/lyrics"
            header_down Location "http://grizzlyrics.duckdns.org:443"  "/api/lyrics"
            header_down Location "http://grizzlyrics.duckdns.org"      "/api/lyrics"
            header_down -Access-Control-Allow-Origin

            transport http {
                tls
                tls_server_name grizzlyrics.duckdns.org
            }
        }
    }

    handle /api/nextcloud/* {
        uri strip_prefix /api/nextcloud

        reverse_proxy 127.0.0.1:443 {
            header_up  Host              grizzlyrics.duckdns.org
            header_up  Authorization     "Basic cGFwYW91cnM6MjkwODA5"
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_up  X-Forwarded-Proto https

            header_down -Authorization
            header_down -WWW-Authenticate
            header_down -Access-Control-Allow-Origin

            transport http {
                tls
                tls_server_name grizzlyrics.duckdns.org
            }
        }
    }

    @notFile {
        not path *.js *.css *.png *.jpg *.svg *.ico *.woff* *.ttf *.webp *.json *.html
        not path /api/*
    }
    rewrite @notFile /index.html
    file_server

    log {
        output file /var/log/caddy/beartify-lan-access.log
        format json
    }
}


# ──────────────────────────────────────────────────────────────────────
#  6. BEARTIFY LAN — http://192.168.0.2
# ──────────────────────────────────────────────────────────────────────
http://192.168.0.2 {

    import cors_tauri
    route {
        uri replace // /
    }

    root * /var/www/beartify
    encode zstd gzip

    header {
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }

    @static {
        path *.js *.css *.woff2 *.woff *.ttf *.png *.jpg *.svg *.ico *.webp
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # sw.js ne doit JAMAIS être mis en cache longue durée par le navigateur :
    # c'est ce fichier qui déclenche la détection de mise à jour du Service
    # Worker (P2-3) — @static ci-dessus le catégorise à tort comme un *.js
    # normal et le rendrait immutable pendant un an, bloquant toute mise à
    # jour du SW. manifest.json est moins critique mais reçoit un cache
    # court plutôt que le "immutable" 1 an de @static, au cas où icônes ou
    # nom changeraient.
    @sw_file {
        path /sw.js
    }
    header @sw_file Cache-Control "no-cache, no-store, must-revalidate"
    header @sw_file Service-Worker-Allowed "/"

    @manifest_file {
        path /manifest.json
    }
    header @manifest_file Cache-Control "public, max-age=86400"

    @jellyfin_images {
        path /api/jellyfin/Items/*/Images/*
    }
    header @jellyfin_images Cache-Control "no-cache"

    import drm_routes
    import libretranslate_proxy
    import playlist_import_proxy
    import download_vip_headers

    # PROXY POCKETBASE (Beartify — playlists / présence / social / stats)
    handle /api/pb/* {
        uri strip_prefix /api/pb
        reverse_proxy 127.0.0.1:8095 {
            header_up  X-Real-IP       {remote_host}
            header_up  X-Forwarded-For {remote_host}
            flush_interval -1
        }
    }

    handle /api/jellyfin/* {
        uri strip_prefix /api/jellyfin

        reverse_proxy 127.0.0.1:8096 {
            flush_interval -1

            header_up  X-Emby-Token      "7510ccb4df644453aad890f454549d15"
            header_up  Host              grizzly-stream.duckdns.org
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_up  X-Forwarded-Proto {scheme}
            header_up  Connection        {http.request.header.Connection}
            header_up  Upgrade           {http.request.header.Upgrade}

            # ✅ FIX CORS v2 (bug covers arrière-plan immersif en Tauri) :
            # header_down est exécuté APRÈS le "header @origin_ok" posé par
            # cors_tauri en tête de site block, sur la même map de réponse.
            # Du coup l'ancien "header_down -Access-Control-Allow-Origin" ne
            # supprimait pas seulement l'en-tête renvoyé par Jellyfin : il
            # supprimait AUSSI celui déjà ajouté par cors_tauri, laissant la
            # réponse totalement sans Access-Control-Allow-Origin. Invisible
            # en usage web classique (requête same-origin, CORS non vérifié
            # par le navigateur) mais bloquant en Tauri (webview sur une
            # origine différente → requête cross-origin → CORS appliqué).
            # On supprime donc l'en-tête existant (celui de Jellyfin, ou le
            # nôtre déjà consommé) PUIS on le réinjecte nous-mêmes avec la
            # bonne valeur, dans ce même bloc, pour être sûrs qu'il survit
            # jusqu'à la réponse finale.
            header_down -Access-Control-Allow-Origin
            header_down Access-Control-Allow-Origin "{http.request.header.Origin}"
            header_down -X-Emby-Token
            header_down -Cache-Control
            header_down Location "https://grizzly-stream.duckdns.org" "/api/jellyfin"
            header_down Location "http://grizzly-stream.duckdns.org"  "/api/jellyfin"
            header_down Location "http://127.0.0.1:8096"              "/api/jellyfin"
            header_down Location `\?api_key=[^&]*&` `?`
            header_down Location `\?api_key=[^&]*$` ``
            header_down Location `&api_key=[^&]*`   ``
        }
    }

    handle /api/lastfm/* {
        uri strip_prefix /api/lastfm
        rewrite * {path}?{query}&api_key=b25b959554ed76058ac220b7b2e0a026&format=json

        reverse_proxy https://ws.audioscrobbler.com {
            header_up  Host              ws.audioscrobbler.com
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_down -X-Api-Key
            header_down -Access-Control-Allow-Origin
        }
    }

    handle /api/lyrics/* {
        uri strip_prefix /api/lyrics

        reverse_proxy 127.0.0.1:443 {
            header_up  Host              grizzlyrics.duckdns.org
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_up  X-Forwarded-Proto https

            header_down Location "https://grizzlyrics.duckdns.org:443" "/api/lyrics"
            header_down Location "https://grizzlyrics.duckdns.org"     "/api/lyrics"
            header_down Location "http://grizzlyrics.duckdns.org:443"  "/api/lyrics"
            header_down Location "http://grizzlyrics.duckdns.org"      "/api/lyrics"
            header_down -Access-Control-Allow-Origin

            transport http {
                tls
                tls_server_name grizzlyrics.duckdns.org
            }
        }
    }

    handle /api/nextcloud/* {
        uri strip_prefix /api/nextcloud

        reverse_proxy 127.0.0.1:443 {
            header_up  Host              grizzlyrics.duckdns.org
            header_up  Authorization     "Basic cGFwYW91cnM6MjkwODA5"
            header_up  X-Real-IP         {remote_host}
            header_up  X-Forwarded-For   {remote_host}
            header_up  X-Forwarded-Proto https

            header_down -Authorization
            header_down -WWW-Authenticate
            header_down -Access-Control-Allow-Origin

            transport http {
                tls
                tls_server_name grizzlyrics.duckdns.org
            }
        }
    }

    @notFile {
        not path *.js *.css *.png *.jpg *.svg *.ico *.woff* *.ttf *.webp *.json *.html
        not path /api/*
    }
    rewrite @notFile /index.html
    file_server

    log {
        output file /var/log/caddy/beartify-node-server.log
        format json
    }
}
