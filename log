  <!-- ══ Auth bootstrap - APRÈS tout le DOM ══ -->
  <script>
    (function () {
      // _t() ne peut jamais lever d'exception : si BeartifyI18n n'est pas
      // encore prêt, il retombe silencieusement sur le texte français fourni.
      function _t(key, fallback, params) {
        try {
          if (window.BeartifyI18n) return window.BeartifyI18n.t(key, fallback, params);
        } catch (e) { /* ne jamais laisser un souci de traduction casser l'app */ }
        return fallback;
      }

      var overlay  = document.getElementById('authOverlay');
      var dropdown = document.getElementById('profileDropdown');
      var btnProf  = document.getElementById('btnProfile');

      function openModal() {
        overlay.classList.add('open');
        document.body.classList.add('modal-open');
      }
      function closeModal() {
        overlay.classList.remove('open');
        document.body.classList.remove('modal-open');
      }
      function openDropdown() {
        var rect = btnProf.getBoundingClientRect();
        dropdown.style.top   = (rect.bottom + 8) + 'px';
        dropdown.style.right = (window.innerWidth - rect.right) + 'px';
        dropdown.classList.add('open');
      }
      function closeDropdown() {
        dropdown.classList.remove('open');
      }

      window._authOpenModal     = openModal;
      window._authCloseModal    = closeModal;
      window._authOpenDropdown  = openDropdown;
      window._authCloseDropdown = closeDropdown;

      btnProf.addEventListener('click', function (e) {
        e.stopPropagation();
        if (window._authUser) {
          dropdown.classList.contains('open') ? closeDropdown() : openDropdown();
        } else {
          openModal();
        }
      });

      document.getElementById('authModalClose').addEventListener('click', closeModal);
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) closeModal();
      });

      document.addEventListener('click', function (e) {
        if (!dropdown.contains(e.target) && e.target !== btnProf) {
          closeDropdown();
        }
      });

      document.getElementById('authDiscordBtn').addEventListener('click', function () {
        if (window._authDiscord) window._authDiscord();
      });
      document.getElementById('authGoogleBtn').addEventListener('click', function () {
        if (window._authGoogle) window._authGoogle();
      });
      document.getElementById('authSettingsBtn')?.addEventListener('click', function () {
        closeModal();
        if (window._openSettings) window._openSettings();
      });
      document.getElementById('authVipBtn')?.addEventListener('click', function () {
        closeModal();
      });

      // ── Conditions d'utilisation ───────────────────────────────
      var termsOverlay = document.getElementById('termsOverlay');
      document.getElementById('authTermsLink').addEventListener('click', function(e) {
        e.preventDefault();
        termsOverlay.style.display = 'flex';
        termsOverlay.style.alignItems = 'center';
        termsOverlay.style.justifyContent = 'center';
        termsOverlay.classList.add('open');
      });
      document.getElementById('termsModalClose').addEventListener('click', function() {
        termsOverlay.classList.remove('open');
        setTimeout(function(){ termsOverlay.style.display='none'; }, 200);
      });
      document.getElementById('termsAcceptBtn').addEventListener('click', function() {
        termsOverlay.classList.remove('open');
        setTimeout(function(){ termsOverlay.style.display='none'; }, 200);
      });
      termsOverlay.addEventListener('click', function(e) {
        if (e.target === termsOverlay) {
          termsOverlay.classList.remove('open');
          setTimeout(function(){ termsOverlay.style.display='none'; }, 200);
        }
      });

      // ── VIP ────────────────────────────────────────────────────
      var vipOverlay = document.getElementById('vipOverlay');
      function openVipModal() {
        closeDropdown();
        vipOverlay.style.display = 'flex';
        vipOverlay.style.alignItems = 'center';
        vipOverlay.style.justifyContent = 'center';
        vipOverlay.classList.add('open');
        document.getElementById('vipCodeError').style.display = 'none';
        document.getElementById('vipCodeInput').value = '';
      }
      function closeVipModal() {
        vipOverlay.classList.remove('open');
        setTimeout(function(){ vipOverlay.style.display='none'; }, 200);
      }
      document.getElementById('pdVipBtn').addEventListener('click', openVipModal);
      document.getElementById('vipModalClose').addEventListener('click', closeVipModal);
      vipOverlay.addEventListener('click', function(e) {
        if (e.target === vipOverlay) closeVipModal();
      });
      document.getElementById('vipActivateBtn').addEventListener('click', function() {
        var code = document.getElementById('vipCodeInput').value.trim().replace(/[-\s]/g,'');
        var errEl = document.getElementById('vipCodeError');
        if (code.length !== 16) {
          errEl.textContent = _t('text-code-length', 'Le code doit contenir exactement 16 caractères.');
          errEl.style.display = 'block';
          return;
        }
        // Validation simple côté client — la vraie vérification se fait côté Firebase
        if (window.FirebaseSync && window.FirebaseSync.activateVip) {
          window.FirebaseSync.activateVip(code).then(function(ok) {
            if (ok) {
              closeVipModal();
              if (window._showNotification) window._showNotification(_t('vip-activated-success', '✦ Statut VIP activé avec succès !'), 'success');
            } else {
              errEl.textContent = _t('vip-code-invalid', 'Code invalide ou déjà utilisé.');
              errEl.style.display = 'block';
            }
          });
        } else {
          errEl.textContent = _t('vip-service-unavailable', 'Service indisponible. Réessayez plus tard.');
          errEl.style.display = 'block';
        }
      });
    })();
  </script>
  <!-- ══════════════════════════════════════════════════════════
       MOBILE INIT v5 - Interface Spotify Android (Définitive)
       · Tap mini-player → window._openImmersive() (mode immersif)
       · body.mob-lib → bibliothèque plein-écran
       · 3 onglets fixes : Accueil / Rechercher / Bibliothèque
       · body.imv-open → #mob-nav caché (background.js gère ça)
  ══════════════════════════════════════════════════════════ -->
  <script>
  (function () {
    'use strict';
    var BP = 768;
    function isMob() { return window.innerWidth <= BP; }

    /* ── 1. Classe is-mobile sync ─────────────────────────── */
    function syncMob() { document.documentElement.classList.toggle('is-mobile', isMob()); }
    syncMob();
    window.addEventListener('resize', function () {
      syncMob();
      if (!isMob()) {
        document.body.classList.remove('mob-lib');
        setTab('home');
        if (nav) nav.style.display = 'none';
      } else {
        if (nav) nav.style.display = 'flex';
      }
    });

    /* ── 2. Références DOM ────────────────────────────────── */
    var nav          = document.getElementById('mob-nav');
    var sidebar      = document.getElementById('sidebar');
    var playerBar    = document.querySelector('.player-bar');
    var progressFill = document.getElementById('progressFill');

    if (nav) nav.style.display = isMob() ? 'flex' : 'none';

    /* ── 3. Onglet actif ──────────────────────────────────── */
    var curTab = 'home';
    function setTab(t) {
      curTab = t;
      if (!nav) return;
      nav.querySelectorAll('.mob-tab').forEach(function (b) {
        b.classList.toggle('active', b.dataset.tab === t);
      });
    }

    /* ── 4. Navigation ────────────────────────────────────── */
    /* Ferme le mode immersif avant toute navigation mobile   */
    function closeImmersive() {
      if (window._closeImmersive) window._closeImmersive();
    }

    function goHome() {
      closeImmersive();
      document.body.classList.remove('mob-lib');
      var bh = document.getElementById('btnHome');
      if (bh) bh.click();
      setTab('home');
    }
    function goSearch() {
      closeImmersive();
      document.body.classList.remove('mob-lib');
      setTab('search');
      var inp = document.getElementById('topSearchInput');
      if (inp) setTimeout(function () { inp.focus(); }, 50);
    }
    function goLibrary() {
      closeImmersive();
      if (curTab === 'library') { goHome(); return; }
      if (sidebar) sidebar.classList.remove('collapsed');
      document.body.classList.add('mob-lib');
      setTab('library');
    }

    /* ── 5. Bottom nav ────────────────────────────────────── */
    if (nav) {
      nav.addEventListener('click', function (e) {
        if (!isMob()) return;
        var btn = e.target.closest('.mob-tab');
        if (!btn) return;
        ({ home: goHome, search: goSearch, library: goLibrary }
          [btn.dataset.tab] || goHome)();
      });
    }

    /* ── 6. Mini-player tap → mode immersif ──────────────── */
    if (playerBar) {
      playerBar.addEventListener('click', function (e) {
        if (!isMob()) return;
        if (e.target.closest(
          '#playPauseBtn,#nextBtn,#prevBtn,#shuffleBtn,#repeatBtn,.mini-like,.mini-etc'
        )) return;
        /* _openImmersive défini par background.js (déjà mobile-ready) */
        if (window._openImmersive) window._openImmersive();
      });
    }

    /* ── 7. Bibliothèque : navigation explicite par type d'item ── */
    var trackList = document.getElementById('trackList');
    if (trackList) {
      trackList.addEventListener('click', function (e) {
        if (!isMob()) return;

        /* TOUS les items de sidebar utilisent .sidebar-playlist-hint
           (pas .lib-item) - c'est la vraie classe parente               */
        var item = e.target.closest('.sidebar-playlist-hint');
        if (!item) return;

        var navigated = false;

        if (item.classList.contains('lib-liked-songs-row')) {
          window.showPlaylistView?.('liked');
          navigated = true;
        } else if (item.classList.contains('lib-favorites-row')) {
          window.showPlaylistView?.('favorites');
          navigated = true;
        } else if (item.classList.contains('lib-custom-playlist-row')) {
          var pid = item.dataset.playlistId;
          if (pid) { window.showPlaylistView?.('custom:' + pid); navigated = true; }
        } else if (item.classList.contains('lib-fav-album-row')) {
          var al = item.dataset.album;
          if (al) { window.showDetailView?.('album', al); navigated = true; }
        } else if (item.classList.contains('lib-fav-artist-row')) {
          var ar = item.dataset.artist;
          if (ar) { window.showDetailView?.('artist', ar); navigated = true; }
        } else if (item.classList.contains('lib-album-item')) {
          var alb = item.dataset.album;
          if (alb) { window.showDetailView?.('album', alb); navigated = true; }
        }

        if (navigated) {
          document.body.classList.remove('mob-lib');
          setTab('home');
        }
      });
    }

    /* ── 8. Barre de progression 2px dans mini-player ─────── */
    if (playerBar) {
      var pg = document.createElement('div'); pg.className = 'mob-mini-progress';
      var pf = document.createElement('div'); pf.className = 'mob-mini-fill';
      pg.appendChild(pf); playerBar.appendChild(pg);
      if (progressFill) {
        new MutationObserver(function () {
          pf.style.width = progressFill.style.width || '0%';
        }).observe(progressFill, { attributes: true, attributeFilter: ['style'] });
      }
    }

    /* ── 9. API publique ──────────────────────────────────── */
    window._mob = { goHome: goHome, goLibrary: goLibrary, isMob: isMob };
  })();
  </script>

  <audio id="btAudio" preload="none"></audio>
  <script src="blindtest.js"></script>

