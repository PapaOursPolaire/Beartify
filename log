    <!-- Préconnexions : démarre DNS+TCP+TLS pendant le parsing du <head>,
         au lieu d'attendre que le parseur atteigne chaque <script src>.
         Ciblé sur les origines externes réellement sur le chemin critique
         (Firebase/gstatic + PocketBase SDK, chargés avant le 1er paint) et
         lrclib.net (fallback paroles, fréquemment sollicité). Le proxy
         Jellyfin n'a pas besoin d'entrée ici : il passe par le même
         domaine que la page (Caddy), donc déjà connecté. -->
    <link rel="preconnect" href="https://www.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://lrclib.net" crossorigin>
    <!-- Firebase SDK (compat) - gère l'auth Google nativement via popup -->
    <!-- ⚠️ CONSERVÉ EN ENTIER : le fallback Firebase Native (firestore-compat
         inclus) doit rester pleinement fonctionnel en secours de PocketBase -->
    <!-- ⚠️ FIX : sous l'origine custom tauri:// (WebKitGTK/Linux), le vrai
         script gapi (apis.google.com/js/api.js, chargé dynamiquement par
         firebase-auth-compat.js pour son infra popup/redirect interne)
         échoue à initialiser gapi.iframes (sondage cross-domain vers
         developers.google.com rejeté par CORS sous cette origine). L'
         exception qui en résulte est levée dans un callback brut, pas dans
         une promesse — elle ne rejette rien, elle bloque juste pour
         toujours. Résultat : TOUTE méthode d'auth du SDK (pas seulement
         signInWithPopup/Redirect) reste bloquée indéfiniment, y compris
         signInWithCredential utilisé par le flow PKCE Tauri qui n'a
         pourtant besoin d'aucune infra popup.
         On bloque donc ici le chargement du vrai script gapi (retiré de
         script-src dans tauri.conf.json) et on le remplace par un stub
         minimal qui répond immédiatement à gapi.load(), pour que l'init
         interne de Firebase se termine sans jamais bloquer — même si
         cette infra popup n'est de toute façon jamais utilisée sur Tauri. -->
    <script>
      // Détection via location plutôt que window.__TAURI__ : ce dernier n'est
      // pas garanti injecté à ce stade sur WebKitGTK (même piège que le bug
      // _fbIsTauri corrigé précédemment dans firebase-config.js). location.*
      // est disponible immédiatement, sans dépendre d'un timing d'injection.
      //   - Linux (WebKitGTK)         : location.protocol === 'tauri:'
      //   - Windows/Android (WebView2): location.hostname === 'tauri.localhost'
      var _looksLikeTauri = location.protocol === 'tauri:' || location.hostname === 'tauri.localhost';
      if (_looksLikeTauri) {
        window.gapi = {
          load: function (_libs, callback) {
            var onload = (callback && callback.callback) || callback;
            if (typeof onload === 'function') setTimeout(onload, 0);
          },
          iframes: {
            getContext: function () { return null; },
            CROSS_ORIGIN_IFRAMES_FILTER: function () { return false; },
          },
        };
        console.log('[Firebase] Stub gapi installé (origine Tauri détectée via location : ' + location.protocol + '//' + location.hostname + ')');
      }
    </script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-auth-compat.js"></script>
